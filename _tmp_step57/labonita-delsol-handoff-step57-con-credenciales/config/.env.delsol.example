# La Bonita · DELSOL API local config
# Copiar como .env.delsol.local y completar localmente.
# NO subir este archivo con credenciales reales a GitHub.

DELSOL_LOGIN_URL=https://api.sdelsol.com/login/Autenticar
DELSOL_ADMIN_URL=https://api.sdelsol.com/admin
DELSOL_EJERCICIO=2026

# Completar con los datos reales entregados por DELSOL/Kiki.
DELSOL_CODIGO_FABRICANTE=
DELSOL_CODIGO_CLIENTE=
DELSOL_BASE_DATOS=FS006
DELSOL_PASSWORD=

# Estrategia obligatoria
DELSOL_TOKEN_STRATEGY=fresh-per-operation
