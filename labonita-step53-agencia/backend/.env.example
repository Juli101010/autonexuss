PORT=3001
NODE_ENV=development
JWT_SECRET=dev-secret-change-me-local
ALLOW_PUBLIC_REGISTER=1

# DELSOL: La Bonita funciona aunque esto quede en mock/read_only.
# mock: no llama a DELSOL y guarda operaciones en cola.
# read_only: reservado para pruebas de lectura.
# live: usar solo cuando DELSOL tenga escritura habilitada y tablas confirmadas.
DELSOL_MODE=mock
DELSOL_DEFAULT_EJERCICIO=2026
DELSOL_WRITE_ENABLED=0
DELSOL_LOGIN_URL=https://api.sdelsol.com/login/Autenticar
DELSOL_ADMIN_URL=
DELSOL_CODIGO_FABRICANTE=
DELSOL_CODIGO_CLIENTE=
DELSOL_BASE_DATOS=
DELSOL_PASSWORD=

# Conector 1: DELSOL Facturación (pendiente de tablas factura/cabecera/líneas/cobros)
DELSOL_FACTURACION_ENABLED=0
DELSOL_FACTURACION_BASE_URL=
DELSOL_FACTURACION_FABRICANTE=
DELSOL_FACTURACION_CLIENTE=
DELSOL_FACTURACION_PASSWORD=
DELSOL_FACTURACION_DATABASE=
DELSOL_FACTURACION_EJERCICIO=2026
DELSOL_FACTURACION_WRITE_ENABLED=0

# Conector 2: DELSOL Laboral / Nominasol (F_TRA / F_CON / F_NOM)
DELSOL_LABORAL_ENABLED=0
DELSOL_LABORAL_BASE_URL=
DELSOL_LABORAL_FABRICANTE=
DELSOL_LABORAL_CLIENTE=
DELSOL_LABORAL_PASSWORD=
DELSOL_LABORAL_DATABASE=
DELSOL_LABORAL_EJERCICIO=2026
DELSOL_LABORAL_WRITE_ENABLED=0
DELSOL_NOMINASOL_WRITE_CONFIRMED=0

# No guardar credenciales reales en frontend ni en capturas.
REMIND_CRON=0 9 * * *
FRIDAY_PAYOUTS_CRON=0 10 * * 5

# Backup SQLite admin: crea un unico archivo rotativo y reemplaza el anterior.
BACKUP_AUTO_ENABLED=1
BACKUP_CRON=0 2 * * *
BACKUP_DIR=backups

# Servicio standalone de facturacion interna.
# Debe coincidir con billing-service/.env.example.
BILLING_BASE_URL=http://127.0.0.1:3010
BILLING_INTERNAL_KEY=supersecreto123
